@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="text-danger">My Events</h2>
        <a asp-action="CreateEvent" class="btn btn-danger">Create New Event</a>
    </div>
    <hr />

    <div class="row">
        @if (!Model.Any())
        {
            <div class="alert alert-info">You haven't created any events yet.</div>
        }
        else
        {
            @foreach (var ev in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">@ev.Name</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</p>
                            <p><strong>Location:</strong> @ev.Location</p>
                            <a asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-outline-danger w-100">Manage Event & View Enrolments</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>