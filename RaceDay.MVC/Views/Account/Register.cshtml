@model RaceDay.MVC.Models.Dtos.RegisterDto

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-success">Create a RaceDay Account</h3>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Register" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Full Name</label>
                            <input asp-for="Name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" type="password" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">I am a...</label>
                            <select asp-for="Role" class="form-select">
                                <option value="Participant">Participant (I want to join events)</option>
                                <option value="Organiser">Organiser (I want to create events)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Register</button>
                    </form>

                    <p class="text-center mt-3">
                        Already have an account? <a asp-action="Login">Login here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>